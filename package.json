{
  "name": "videoforge",
  "version": "0.1.0",
  "description": "An open-source, local-first, AI-assisted motion graphics video generator",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && node scripts/generate-schema.js",
    "prepare": "husky",
    "render:example": "npm run build && node scripts/render-example.js"
  },
  "keywords": [
    "video",
    "generator",
    "gsap",
    "playwright",
    "ffmpeg",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@modelcontextprotocol/sdk": "^0.6.0",
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "gsap": "^3.12.5",
    "ora": "^8.0.1",
    "playwright": "^1.45.1",
    "prismjs": "^1.30.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "supertest": "^7.0.0",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
