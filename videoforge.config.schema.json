{
  "$ref": "#/definitions/VideoForgeConfig",
  "definitions": {
    "VideoForgeConfig": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "default": "VideoForge Project"
            },
            "resolution": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "default": 1280
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "default": 720
                }
              },
              "additionalProperties": false,
              "default": {
                "width": 1280,
                "height": 720
              }
            },
            "fps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 30
            },
            "outputPath": {
              "type": "string",
              "default": "./output/video.mp4"
            }
          },
          "additionalProperties": false,
          "default": {
            "title": "VideoForge Project"
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "primaryColor": {
              "type": "string",
              "minLength": 1
            },
            "secondaryColor": {
              "type": "string",
              "minLength": 1
            },
            "fontFamily": {
              "type": "string",
              "minLength": 1
            },
            "logoPath": {
              "type": "string"
            }
          },
          "required": [
            "primaryColor",
            "secondaryColor",
            "fontFamily"
          ],
          "additionalProperties": false
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "minLength": 1
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "data": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              },
              "transition": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "cut",
                      "fade"
                    ],
                    "default": "cut"
                  },
                  "duration": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "default": {
                  "type": "cut",
                  "duration": 0
                }
              }
            },
            "required": [
              "id",
              "template",
              "duration"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "theme",
        "scenes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}